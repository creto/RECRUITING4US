# Origin of the RECRUIT4US app. "Ingresar" and "Solicitar demo" sign-in links
# point at `${VITE_APP_ORIGIN}/login`. Empty = same origin (co-hosted).
VITE_APP_ORIGIN=
# Canonical public origin of this website (used for canonical URLs + sitemap).
VITE_SITE_ORIGIN=https://recruit4us.tiglobal.com.co
# Optional HTTPS endpoint that accepts the demo-request JSON. Empty = the form
# opens a pre-filled email to VITE_DEMO_EMAIL instead of posting anywhere.
VITE_DEMO_ENDPOINT=
VITE_DEMO_EMAIL=info@tiglobal.com.co
