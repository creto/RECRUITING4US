{
  "name": "recruit4us-website-vnext",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "RECRUIT4US public product website (immersive, Spanish-first). Lives beside the RECRUIT4US app in this repo; never imports from it.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5190",
    "build": "tsc -b && vite build && node scripts/seo-routes.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 5191",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "claims": "node scripts/check-claims.mjs",
    "og": "node scripts/make-og.mjs",
    "smoke": "node scripts/smoke.mjs",
    "shots": "node scripts/screenshots.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run claims"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
