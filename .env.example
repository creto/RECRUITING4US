# Copy to the host's secret store. Do not commit a filled file.
# Empty means that feature stays off. A name here is not a connection.

# --- Required for a durable deploy ---
# Postgres connection. Without it the process uses an embedded database that dies on restart.
DATABASE_URL=
# Signs session cookies. A new value signs everyone out. Leave empty only in preview.
BETTER_AUTH_SECRET=
# Public origin of this app, including https. Example: https://hire.example.com
BETTER_AUTH_URL=

# --- Auth ---
# false forces the dev user. Omit this on a real deploy.
# VITE_AUTH_ENABLED=true
# Federated sign-in. The preview host injects these. A self-hosted deploy must set them or sign-in stays on the preview client.
GROK_AUTH_ISSUER=
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=
GROK_PROJECT_ID=
GROK_GATE_ORIGIN=

# --- Email (optional) ---
# Unset: messages stay in the workspace mailbox. They are not delivered.
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=
MAIL_FROM=
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
# Prefer a dedicated Resend key for unsuppress (DELETE /suppressions/{email}).
# If unset, MAIL_SMTP_PASSWORD is used only when it starts with re_.
RESEND_API_KEY=
# HMAC secret for POST /api/mail/events. Unsigned events are refused.
MAIL_INBOUND_SECRET=

# --- Calendar (optional) ---
CALENDAR_VENDOR_URL=
CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
CALENDAR_REDIRECT_URI=
CALENDAR_TOKEN_URL=

# --- Job board and HR (optional) ---
JOB_BOARD_URL=
JOB_BOARD_TOKEN=
HRIS_EXPORT_URL=
HRIS_EXPORT_TOKEN=

# --- Object storage (optional) ---
# Unset: résumé bytes stay in Postgres. R2 also needs the endpoint.
OBJECT_STORE_PROVIDER=
OBJECT_STORE_BUCKET=
OBJECT_STORE_REGION=
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_ACCESS_KEY_ID=
OBJECT_STORE_SECRET_ACCESS_KEY=

# --- Webhooks (optional) ---
# Unset: the body is refused and nothing is stored.
WEBHOOK_SECRET=
PROVIDER_CALLBACK_SECRET=

# --- Errors (optional) ---
# The DSN does not send events until a sink is connected in code.
SENTRY_DSN=
# Visible to the browser. Not a server secret.
VITE_SENTRY_DSN=

# --- Do not set in production ---
# Allows outbound calls to loopback. Tests only.
# OUTBOUND_ALLOW_LOOPBACK=
